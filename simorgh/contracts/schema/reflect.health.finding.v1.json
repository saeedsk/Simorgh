  "description": "Payload of `reflect.health.finding` (catalog v1).",
  "properties": {
    "action_taken": {
      "anyOf": [
        {
          "enum": [
            "none",
            "request_reset",
            "request_pause_hint"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "detail": {
      "type": "string"
    },
    "severity": {
      "enum": [
        "info",
        "warn",
        "critical"
      ],
      "type": "string"
    }
  },
  "required": [
    "severity",
    "detail"
  ],
  "title": "reflect.health.finding",
  "type": "object"
}
