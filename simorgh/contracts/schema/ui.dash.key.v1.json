{
  "$id": "https://simorgh.local/schema/ui.dash.key.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "One remote-control key for the dashboard page: move, ok, back, or a media key.",
  "properties": {
    "key": {
      "enum": [
        "left",
        "right",
        "up",
        "down",
        "ok",
        "back",
        "playpause",
        "next",
        "prev"
      ],
      "type": "string"
    }
  },
  "required": [
    "key"
  ],
  "title": "ui.dash.key",
  "type": "object"
}
