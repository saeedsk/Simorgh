    },
    "background": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "brief": {
      "type": "string"
    },
    "context_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "handle": {
      "type": [
        "string",
        "null"
      ]
    },
    "max_steps": {
      "type": [
        "integer",
        "null"
      ]
    },
    "plan_node": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "report": {
      "type": [
        "string",
        "null"
      ]
    },
    "requester": {
      "type": "string"
    },
    "requester_channel": {
      "type": "string"
    },
    "subject": {
      "type": [
        "string",
        "null"
      ]
    }
  },
