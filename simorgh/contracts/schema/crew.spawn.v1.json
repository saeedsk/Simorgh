      "type": [
        "string",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "report": {
      "type": [
        "string",
        "null"
      ]
    },
    "requester": {
      "type": "string"
    },
    "requester_channel": {
      "type": "string"
    }
  },
