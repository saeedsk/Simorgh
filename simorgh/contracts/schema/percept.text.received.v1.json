{
  "$id": "https://simorgh.local/schema/percept.text.received.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "channel=command + command for routed commands; steer=true marks a mid-task correction; channel=voice carries device/speaker/confidence from the voice pipeline, plus the speaker's relation and the room's recent lines that were not addressed to Sim.",
  "properties": {
    "channel": {
      "enum": [
        "cli",
        "voice",
        "api",
        "chat",
        "command",
        "whatsapp",
        "telegram"
      ],
      "type": "string"
    },
    "command": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ]
    },
    "device": {
      "type": [
        "string",
        "null"
      ]
    },
    "room": {
      "type": [
        "string",
        "null"
      ]
    },
    "session_id": {
      "type": "string"
    },
    "speaker": {
      "type": [
        "string",
        "null"
      ]
    },
    "speaker_before": {
      "type": [
        "string",
        "null"
      ]
    },
    "speaker_doubt": {
      "type": [
        "string",
        "null"
      ]
    },
    "speaker_relation": {
      "type": [
        "string",
        "null"
      ]
    },
    "speaker_score": {
      "type": [
        "string",
        "null"
      ]
    },
    "steer": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "user_id": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "channel",
    "text",
    "session_id"
  ],
  "title": "percept.text.received",
  "type": "object"
}
