{
  "$id": "https://simorgh.local/schema/voice.control.request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "set: change one safe setting (voice/settings.py) live and persist it; key/value travel with it.",
  "properties": {
    "action": {
      "enum": [
        "on",
        "off",
        "mute",
        "unmute",
        "barge_on",
        "barge_off",
        "aec_on",
        "aec_off",
        "set"
      ],
      "type": "string"
    },
    "key": {
      "type": [
        "string",
        "null"
      ]
    },
    "value": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "action"
  ],
  "title": "voice.control.request",
  "type": "object"
}
