{
  "$id": "https://simorgh.local/schema/voice.transcript.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "echo=true: the words were Sim's own reply coming back through the microphone; not a turn. partial=true: provisional, replaced by the next transcript for the same turn.",
  "properties": {
    "confidence": {
      "type": "number"
    },
    "device": {
      "type": "string"
    },
    "echo": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "engine": {
      "type": "string"
    },
    "partial": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "seconds": {
      "type": "number"
    },
    "session_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "text": {
      "type": "string"
    },
    "turn": {
      "type": [
        "integer",
        "null"
      ]
    }
  },
  "required": [
    "text",
    "confidence",
    "seconds",
    "engine",
    "device"
  ],
  "title": "voice.transcript",
  "type": "object"
}
