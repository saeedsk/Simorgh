<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sim</string>
	<key>NSCameraUsageDescription</key>
	<string>Scanning the barcode Sim shows, to pair this phone.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Talking to Sim.</string>
	<!-- Sim lives on the house network and is reached over plain HTTP there.
	     This exception is for the LOCAL network only: it does not permit
	     cleartext to anywhere else, so a rendezvous on the internet still
	     has to be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Reaching Sim on the house network.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
</dict>
</plist>
