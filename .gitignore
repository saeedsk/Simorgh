__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
*.egg-info/
.DS_Store

# simloader.py's decision notes (decisions.jsonl, last_unit.txt, ...),
# scoped to this checkout by default -- see simloader.py's NOTES_DIRNAME.
.simorgh_loader/

# Never commit credentials. Simorgh reads API keys only from environment
# variables at runtime (GEMINI_API_KEY, GOOGLE_API_KEY, ...) -- these
# patterns are a backstop in case a local .env file or key dump ever
# gets created.
.env
.env.*
*.key
secrets/

# Structured data a tool fetched, written by execution/service.py so
# `read_file` and a script can load it. Real data, not source.
results/
.sim-quarantine/

# Persistent scratch: notes, intermediates and working files a long
# piece of work needs somewhere to keep. Deliberately NOT source -- it
# survives across sessions (unlike results/, which is pruned) and is
# never committed or reviewed. See execution/config.py::workspace_dir.
workspace/
# ...except the README, so the directory exists in a fresh clone and
# Sim has somewhere to write on its first run rather than discovering
# the path is missing.
!workspace/
!workspace/README.md

# Scripts run_script stages before running them. Transient.
.simorgh_scripts/
